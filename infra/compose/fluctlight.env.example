FLUCTLIGHT_ENV=development
# Leave secrets empty for the Compose local-development defaults. Production
# deployments must provide explicit values in an untracked fluctlight.env.
FLUCTLIGHT_CORE_SERVICE_KEY=
FLUCTLIGHT_SETTINGS_KEY=
FLUCTLIGHT_TRUSTED_ORIGIN=http://127.0.0.1:13001
FLUCTLIGHT_API_PORT=8080
POSTGRES_USER=fluctlight
POSTGRES_PASSWORD=
POSTGRES_DB=fluctlight
REDIS_URL=redis://redis:6379/0
S3_ACCESS_KEY=fluctlight
S3_SECRET_KEY=
S3_BUCKET=fluctlight-media
TEMPORAL_NAMESPACE=default
