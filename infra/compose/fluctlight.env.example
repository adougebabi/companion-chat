FLUCTLIGHT_ENV=development
# Copy to an untracked private env file and fill every *_REQUIRED value.
# Compose deliberately rejects missing sensitive values; no deployable fallback exists.
FLUCTLIGHT_CORE_SERVICE_KEY=REQUIRED_GENERATE_A_RANDOM_VALUE
FLUCTLIGHT_SETTINGS_KEY=REQUIRED_BASE64_32_BYTE_KEY
# Public browser-facing origins. These must use the actual address users open,
# never a container hostname or a loopback address from another machine.
FLUCTLIGHT_TRUSTED_ORIGIN=https://fluctlight.example.net
FLUCTLIGHT_BFF_ORIGIN=https://fluctlight-api.example.net
# Internal BFF-to-Core address. Keep the Compose service hostname unless Core
# intentionally runs outside this Compose project.
CORE_BASE_URL=http://core:8080
BFF_PORT=3000
BFF_HOST_PORT=13000
WEB_HOST_PORT=13001
FLUCTLIGHT_API_PORT=8080
POSTGRES_USER=fluctlight
# These credentials are interpolated into PostgreSQL/MinIO URLs by Compose;
# generate URL-safe values (hex is recommended) instead of characters such as
# @, :, /, ?, # or %.
POSTGRES_PASSWORD=REQUIRED_GENERATE_A_RANDOM_VALUE
POSTGRES_DB=fluctlight
REDIS_URL=redis://redis:6379/0
S3_ACCESS_KEY=fluctlight
S3_SECRET_KEY=REQUIRED_GENERATE_A_RANDOM_VALUE
S3_BUCKET=fluctlight-media
TEMPORAL_NAMESPACE=default
# Temporal Worker Deployment build claimed by the Go Worker. Keep this aligned
# with the namespace's current deployment version during a staged rollout.
TEMPORAL_WORKER_BUILD_ID=platform-v1
# Optional immutable image overrides for the integration branch.
CORE_GO_IMAGE=yourname/fluctlight-core-go:latest
BFF_IMAGE=yourname/fluctlight-bff:latest
WEB_IMAGE=yourname/fluctlight-web:latest
# Standalone Compose resource ceilings; tune for the target NAS.
CORE_MEMORY_LIMIT=256m
WORKER_MEMORY_LIMIT=768m
BFF_MEMORY_LIMIT=192m
WEB_MEMORY_LIMIT=128m
