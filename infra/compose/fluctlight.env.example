FLUCTLIGHT_ENV=development
FLUCTLIGHT_CORE_SERVICE_KEY=replace-with-a-private-service-key
FLUCTLIGHT_SETTINGS_KEY=replace-with-a-32-byte-base64-settings-key
FLUCTLIGHT_TRUSTED_ORIGIN=http://127.0.0.1:13001
FLUCTLIGHT_API_PORT=8080
POSTGRES_USER=fluctlight
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_DB=fluctlight
REDIS_URL=redis://redis:6379/0
S3_ACCESS_KEY=fluctlight
S3_SECRET_KEY=replace-with-a-private-minio-password
S3_BUCKET=fluctlight-media
TEMPORAL_NAMESPACE=default
