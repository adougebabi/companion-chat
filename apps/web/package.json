{
  "name": "@fluctlight/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_API_SCENARIOS=1 vite",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "node --test test/*.test.mjs",
    "test:platform": "node --test test/*.test.mjs",
    "build": "vite build && node scripts/verify-product-build.mjs && node scripts/verify-react-stack.mjs",
    "test:ui": "playwright test -c e2e/playwright.config.ts",
    "test:ui:install": "playwright install chromium",
    "ui-lab": "vite --open /ui-lab/",
    "ui:gate": "node scripts/ui-gate.mjs",
    "ui:gate:full": "node scripts/ui-gate.mjs --full",
    "ui:baselines": "node scripts/ui-baselines.mjs",
    "dev:mobile-mock": "node scripts/mobile-mock-preview.mjs"
  },
  "dependencies": {
    "@fluctlight/browser-client": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "7.1.5"
  }
}
