{
  "name": "fluctlight-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.7",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "check:commit-images": "node scripts/check-no-images-in-commit.mjs",
    "test:commit-images": "node --test scripts/check-no-images-in-commit.test.mjs",
    "dev": "go -C apps/core-go run ./cmd/api",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e:persona": "node scripts/e2e/persona-layers-real.mjs",
    "regression:v3": "node scripts/e2e/v3-regression/run.mjs --all",
    "regression:v3:list": "node scripts/e2e/v3-regression/run.mjs --list",
    "regression:v3:self-test": "node scripts/e2e/v3-regression/run.mjs --self-test",
    "generate": "pnpm --filter @fluctlight/core-client generate && pnpm --filter @fluctlight/browser-client generate:openapi && pnpm --filter @fluctlight/browser-client generate"
  }
}
